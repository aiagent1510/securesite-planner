generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String // "CUSTOMER" | "ENGINEER"
  phone         String?
  postcode      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  postedJobs         Job[]               @relation("CustomerJobs")
  awardedJobs        Job[]               @relation("AwardedEngineer")
  engineerProfile    EngineerProfile?
  quotes             Quote[]
  unlocks            Unlock[]
  creditTransactions CreditTransaction[]
  reviewsGiven       Review[]            @relation("Reviewer")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EngineerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  headline        String?
  bio             String?
  tradeTypes      String? // comma-separated: "CCTV,ALARMS,GATES"
  coverageArea    String? // e.g. "Manchester + 20 miles"
  yearsExperience Int     @default(0)
  accreditations  String? // comma-separated
  verified        Boolean @default(false)
  credits         Int     @default(20)
  jobsCompleted   Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id                 String   @id @default(cuid())
  customerId         String
  customer           User     @relation("CustomerJobs", fields: [customerId], references: [id])
  category           String // CCTV | ALARMS | GATES | ACCESS | SMART | COMMERCIAL | LIGHTING | REPAIR
  title              String
  description        String?
  postcode           String
  town               String?
  propertyType       String? // house | flat | business | industrial | other
  budget             String?
  preferredDate      String?
  status             String   @default("OPEN") // OPEN | AWARDED | COMPLETED | CANCELLED
  awardedEngineerId  String?
  awardedEngineer    User?    @relation("AwardedEngineer", fields: [awardedEngineerId], references: [id])
  survey             Survey?
  quotes             Quote[]
  reviews            Review[]
  unlocks            Unlock[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Survey {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers   String? // JSON: { stepId: notes }
  aiBrief   String? // markdown job brief generated by AI
  analyzed  Boolean  @default(false)
  createdAt DateTime @default(now())
  photos    SurveyPhoto[]
}

model SurveyPhoto {
  id        String  @id @default(cuid())
  surveyId  String
  survey    Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  stepId    String
  mimeType  String  @default("image/jpeg")
  data      String // base64 payload
  aiNote    String? // AI observation for this photo
  createdAt DateTime @default(now())
}

model Quote {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  engineerId    String
  engineer      User     @relation(fields: [engineerId], references: [id])
  amount        Float
  laborHours    Float?
  materialsNote String?
  message       String?
  status        String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, engineerId])
}

model Unlock {
  id         String   @id @default(cuid())
  engineerId String
  engineer   User     @relation(fields: [engineerId], references: [id])
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cost       Int      @default(3)
  createdAt  DateTime @default(now())

  @@unique([engineerId, jobId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int // positive or negative
  type        String // PURCHASE | UNLOCK | BONUS | REFUND
  description String
  jobId       String?
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("Reviewer", fields: [customerId], references: [id])
  engineerId String // engineer user id
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}
